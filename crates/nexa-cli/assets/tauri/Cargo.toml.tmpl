[package]
name = "{{NAME}}"
version = "0.1.0"
description = "Adaptador de escritorio (Tauri) para el proyecto Nexa \"{{NAME}}\""
edition = "2021"
rust-version = "1.77.2"

[lib]
name = "{{NAME_UNDERSCORE}}_lib"
crate-type = ["staticlib", "cdylib", "rlib"]

[build-dependencies]
tauri-build = { version = "2" }

[dependencies]
serde_json = "1"
serde = { version = "1", features = ["derive"] }
tauri = { version = "2" }

[features]
# Sin esta feature, el binario carga `devUrl` (http://localhost:4321) en vez
# de los assets embebidos de `dist/` — "Could not connect to localhost".
# `nexa build --target desktop` y `cargo tauri build` la activan solos; con un
# `cargo build --release` a mano hay que pasar `--features custom-protocol`.
custom-protocol = ["tauri/custom-protocol"]
