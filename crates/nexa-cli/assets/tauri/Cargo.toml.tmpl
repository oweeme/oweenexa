[package]
name = "{{NAME}}"
version = "0.1.0"
description = "Adaptador de escritorio (Tauri) para el proyecto Nexa \"{{NAME}}\""
edition = "2021"
rust-version = "1.77.2"

[lib]
name = "{{NAME_UNDERSCORE}}_lib"
crate-type = ["staticlib", "cdylib", "rlib"]

[build-dependencies]
tauri-build = { version = "2" }

[dependencies]
serde_json = "1"
serde = { version = "1", features = ["derive"] }
tauri = { version = "2" }
